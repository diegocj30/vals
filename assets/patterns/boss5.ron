    (
      name: "El rasgueo",
      hp: 550,
      steps: [
        Parallel([
          [
            Forever([
              MoveTo(pos: (230.0, 160.0), dur: 288, ease: InOut),
              MoveTo(pos: (410.0, 160.0), dur: 288, ease: InOut),
