                count: 7, arc: 0.16, aim: Fixed(1.05), speed: 250.0,
                rings: 1, speed_step: 40.0, ring_offset: 0.0,
                accel: 0.0, spin: 0.0, ttl: 1.5, kind: 3, flags: 0,
              )),
              Wait(24),
