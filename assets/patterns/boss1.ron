                ease: InOut,
              ),
            ]),
          ],
          [
            Forever([
              Fire((
                count: 14,
                arc: 6.2831855,
                aim: Fixed(0.0),
                speed: 210.0,
                rings: 2,
                speed_step: 40.0,
                ring_offset: 0.14,
                accel: -150.0,
                spin: 0.0,
                ttl: 30.0,
                kind: 0,
                flags: 0,
              )),
              Turn(0.19),
              Wait(26),
            ]),
          ],
          [
            Forever([
              Fire((
                count: 6,
                arc: 6.2831855,
                aim: Fixed(1.0),
                speed: 260.0,
                rings: 1,
                speed_step: 40.0,
                ring_offset: 0.0,
                accel: 0.0,
                spin: 0.0,
                ttl: 30.0,
                kind: 3,
                flags: 0,
              )),
              Turn(0.83),
              Wait(8),
            ]),
          ],
          [
            Forever([
              Wait(90),
              Fire((
                count: 4,
                arc: 0.5,
                aim: AtPlayer,
                speed: 240.0,
                rings: 1,
                speed_step: 40.0,
                ring_offset: 0.0,
                accel: 0.0,
                spin: 0.0,
                ttl: 30.0,
                kind: 1,
                flags: 1,
              )),
            ]),
          ],
        ]),
      ],
    ),
    // --- La coda. era la fase 3 de La Coda, intacta.
    (
      name: "La coda",
      hp: 800,
      steps: [
        Parallel([
          [
            Forever([
              MoveTo(
                pos: (210.0, 130.0),
                dur: 35,
                ease: Out,
              ),
              MoveTo(
                pos: (430.0, 130.0),
                dur: 35,
                ease: Out,
              ),
              MoveTo(
                pos: (320.0, 210.0),
                dur: 35,
                ease: Out,
              ),
            ]),
          ],
          [
            Forever([
              Fire((
                count: 7,
                arc: 6.2831855,
                aim: Fixed(0.0),
                speed: 200.0,
                rings: 2,
                speed_step: 40.0,
                ring_offset: 0.16,
                accel: 0.0,
                spin: 0.0,
                ttl: 30.0,
                kind: 0,
                flags: 0,
              )),
              Turn(0.41),
              Wait(10),
            ]),
          ],
          [
            Forever([
              Fire((
                count: 7,
                arc: 6.2831855,
                aim: Fixed(1.7),
                speed: 150.0,
                rings: 1,
                speed_step: 40.0,
                ring_offset: 0.0,
                accel: 0.0,
                spin: 0.0,
                ttl: 30.0,
                kind: 3,
                flags: 0,
              )),
              Turn(-0.53),
              Wait(7),
            ]),
          ],
          [
            Forever([
              Wait(100),
              Repeat(
                times: 4,
                body: [
                  Fire((
                    count: 6,
                    arc: 0.9,
                    aim: AtPlayer,
                    speed: 330.0,
                    rings: 1,
                    speed_step: 40.0,
                    ring_offset: 0.0,
                    accel: 0.0,
                    spin: 0.0,
                    ttl: 30.0,
                    kind: 1,
                    flags: 1,
                  )),
                  Wait(9),
                ],
              ),
            ]),
          ],
          [
            Forever([
              Wait(180),
              Fire((
                count: 7,
                arc: 6.2831855,
                aim: Fixed(0.0),
                speed: 90.0,
                rings: 1,
                speed_step: 40.0,
                ring_offset: 0.0,
                accel: -60.0,
                spin: 0.0,
                ttl: 30.0,
                kind: 2,
                flags: 1,
