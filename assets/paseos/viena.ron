// EL PASEO DE VIENA. La calle que se anda antes de bailar El Vals.
//
// Un paseo es un nivel de correr y disparar, como los de Cuphead: la calle de
// la ciudad de su baile, con enemigos de su mundo, y al final la puerta del
// salon donde espera el jefe. Este fichero es el nivel entero; el codigo solo
// sabe andar, disparar y hacer caso a lo que diga aqui.
//
// El verbo del vals es GIRAR, a tres tiempos, y aqui todo gira: las hojas
// bajan dando vueltas, las parejas y el husar avanzan valsando y el director
// gira la batuta.
//
// Seis tramos, de izquierda a derecha (la puerta esta en x 7800):
//
//   1. El Ring           0 - 1850   parejas y hojas sueltas. Ensena a disparar
//                                   de frente y a saltar por encima.
//   2. Los cafes      2010 - 3350   camareros tirando platos en arco, uno en un
//                                   balcon. Cada tercer plato es rosa: parry.
//                                   Y el primer husar, por detras.
//   3. El canal       3350 - 4130   tres tramos de acera con el canal en medio.
//                                   Las hojas caen justo encima de los saltos.
//   4. El fiacre      4130 - 5360   EL NUMERO: un canal de 800 que no se salta.
//                                   Se cruza en la barca del fiacre, que va y
//                                   viene; hojas encima y un camarero en la
//                                   otra orilla.
//   5. La escalinata  5360 - 6600   todo junto, con el segundo husar.
//   6. El templete    6600 - 7560   la arena del director: la calle se cierra
//                                   hasta tumbarlo. Luego, la puerta.
//
// En nativo hay HOT-RELOAD, igual que con los jefes: guarda y el nivel se
// rehace sin recompilar, con la jugadora donde estaba. Un RON roto se ignora y
// se sigue con la ultima version buena.
//
// Coordenadas: x crece hacia la derecha, y hacia abajo. El suelo esta en y 470
// (`SUELO_Y`), y la vista mide 960 x 540. El salto sube unas 155 unidades y
// cruza unas 200 corriendo: un foso de mas de 190 ya pide dash o balcon.
//
// Guia de campos:
//   tiempo        ticks por tiempo de la musica (el Danubio va a unos 21). Las
//                 parejas dan su paso fuerte en el "uno" de cada compas de tres.
//   suelo         tramos de acera (desde, hasta). Lo que queda entre dos
//                 tramos es un foso: caer cuesta una vida y vuelves a la acera.
//   plataformas   mesas de cafe y balcones. Se atraviesan desde abajo y se
//                 pisan desde arriba. x es el borde izquierdo, y la superficie.
//                 Con `mueve: Some(Vaiven(dx, dy, periodo))` va y viene hasta
//                 (dx, dy) de su sitio, en `periodo` ticks ida y vuelta, y
//                 lleva a quien la pisa: es la barca del fiacre.
//   enemigos      tipo: Pareja   (baila por la acera hacia ti),
//                       Camarero (tira platos en arco; y = superficie donde
//                                 esta de pie, 0 o sin poner = la acera),
//                       Hoja     (baja girando, una vuelta por compas, y se
//                                 va hacia la izquierda; y = altura a la que
//                                 sale. Se queda en la acera al llegar),
//                       Husar    (despierta como todos pero sale POR DETRAS,
//                                 420 a la izquierda de la jugadora, y viene
//                                 valsando mas rapido que ella. Su x es por
//                                 donde va ella mas 640 al llegar: tiene que
//                                 haber acera a 1060 a su izquierda),
//                       Director (el portero: en su tarima, gira la batuta.
//                                 y = la tarima).
//                 rosa: true solo en hojas: se pueden parriar.
//                 portero: true en el director: cierra la arena.
//                 Despiertan cuando la jugadora esta a 640 de su x.
//   porteria      la arena: una vista entera desde `desde`. Se cierra al
//                 llegar y no se abre hasta tumbar al portero; `ficha` es la
//                 que suelta (su indice en `fichas`).
//   fichas        (x, y) del centro de cada ficha. Se guardan
//                 por su sitio en esta lista: las nuevas, AL FINAL.
(
  nombre: "El paseo de Viena",
  jefe: "El Vals",
  subtitulo: "Camino del baile",
  tiempo: 21,
  largo: 8100.0,
  salida: 140.0,
  puerta: 7800.0,
  suelo: [
    (0.0, 1850.0),
    (2010.0, 3350.0),
    (3530.0, 3950.0),
    (4130.0, 4560.0),
    (5360.0, 8100.0),
  ],
  plataformas: [
    // El Ring: un balcon para aprender que se sube desde abajo.
    (x: 980.0, y: 395.0, ancho: 150.0),
    (x: 1560.0, y: 420.0, ancho: 80.0),
    // Los cafes: mesas bajas y el balcon del camarero.
    (x: 2280.0, y: 420.0, ancho: 80.0),
    (x: 2470.0, y: 360.0, ancho: 150.0),
    (x: 2900.0, y: 420.0, ancho: 80.0),
    // El canal: un balcon sobre cada foso, por si el salto no llega.
    (x: 3380.0, y: 385.0, ancho: 120.0),
    (x: 3620.0, y: 400.0, ancho: 110.0),
    (x: 3990.0, y: 390.0, ancho: 120.0),
    // El fiacre: la barca, a ras de muelle, de una orilla a la otra. Siete
    // compases ida y vuelta; en los extremos frena, que es cuando se sube.
    (x: 4500.0, y: 470.0, ancho: 220.0, mueve: Some(Vaiven(dx: 700.0, dy: 0.0, periodo: 441))),
    // La escalinata.
    (x: 5600.0, y: 400.0, ancho: 140.0),
    (x: 6000.0, y: 360.0, ancho: 150.0),
    (x: 6380.0, y: 420.0, ancho: 80.0),
  ],
  enemigos: [
    // --- El Ring ---
    (tipo: Pareja, x: 800.0),
    (tipo: Hoja, x: 1150.0, y: 230.0),
    (tipo: Hoja, x: 1250.0, y: 190.0),
    (tipo: Hoja, x: 1350.0, y: 230.0),
    (tipo: Pareja, x: 1650.0),
    // --- Los cafes ---
    (tipo: Camarero, x: 2150.0),
    (tipo: Hoja, x: 2360.0, y: 210.0, rosa: true),
    (tipo: Camarero, x: 2545.0, y: 360.0),
    (tipo: Pareja, x: 3050.0),
    // Sale en 2140, cuando ella pasa el balcon del camarero.
    (tipo: Husar, x: 3200.0),
    (tipo: Hoja, x: 3270.0, y: 200.0),
    // --- El canal ---
    (tipo: Pareja, x: 3800.0),
    (tipo: Hoja, x: 3900.0, y: 210.0),
    (tipo: Hoja, x: 3960.0, y: 250.0, rosa: true),
    (tipo: Hoja, x: 4020.0, y: 210.0),
    // --- El fiacre ---
    (tipo: Hoja, x: 4900.0, y: 170.0),
    (tipo: Hoja, x: 5000.0, y: 210.0, rosa: true),
    (tipo: Hoja, x: 5120.0, y: 170.0),
    (tipo: Hoja, x: 5260.0, y: 220.0),
    (tipo: Camarero, x: 5480.0),
    // --- La escalinata ---
    (tipo: Pareja, x: 5800.0),
    (tipo: Camarero, x: 6075.0, y: 360.0),
    (tipo: Pareja, x: 6250.0),
    (tipo: Hoja, x: 6300.0, y: 200.0, rosa: true),
    // Sale en 5460, recien bajada de la barca.
    (tipo: Husar, x: 6520.0),
    // --- El templete ---
    (tipo: Director, x: 7350.0, y: 458.0, portero: true),
  ],
  porteria: Some((desde: 6600.0, ficha: Some(2))),
  // Las fichas. Una en el camino, otra que pide arriesgar y la del
  // director. Se quedan al llegar a la puerta, no al
  // cogerlas.
  fichas: [
    // En la acera del Ring, para que la primera se coja sin buscarla.
    (620.0, 435.0),
    // A ras de agua, en mitad del primer canal. El salto pasa por encima:
    // hay que saltar y dar el dash enseguida.
    (3440.0, 410.0),
    // La que suelta el director al caer, en su tarima.
    (7350.0, 435.0),
  ],
)
